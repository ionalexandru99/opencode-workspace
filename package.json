    "@opentui/solid": "0.5.17",
    "@types/node": "22.20.5",
    "babel-preset-solid": "1.9.12",
    "esbuild": "0.28.2",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  }
}
